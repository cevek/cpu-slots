{
  "name": "cpu-slots",
  "version": "0.1.0",
  "description": "Machine-wide CPU slots for test runners: each test file waits for a slot before its clock starts, so several suites at once queue instead of timing out. Linux; a no-op elsewhere.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    }
  },
  "bin": {
    "cpu-slots-node": "./dist/node-bin.js",
    "cpu-slots-run": "./dist/run-bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/node-bin.js dist/run-bin.js",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm run typecheck && npm test",
    "release": "npm version patch && npm publish && git push --follow-tags",
    "release:minor": "npm version minor && npm publish && git push --follow-tags"
  },
  "peerDependencies": {
    "vitest": ">=4.1"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "keywords": [
    "cpu",
    "slots",
    "semaphore",
    "jobserver",
    "test-runner",
    "vitest",
    "node-test",
    "timeout",
    "agents",
    "linux"
  ],
  "author": "cevek <x.cevek@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cevek/cpu-slots.git"
  },
  "bugs": "https://github.com/cevek/cpu-slots/issues",
  "homepage": "https://github.com/cevek/cpu-slots#readme",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
